# Corpus setup/import credential; never give this URI to the agent or frontend.
MONGODB_URI=
MONGODB_CORPUS_DB=replay_corpus
# Optional separate read-only corpus credential; add before agent-facing real-corpus runs.
MONGODB_CORPUS_READ_URI=
# Replay memory still uses the local file adapter until the Atlas state adapter lands.
REPLAY_STATE_PATH=data/replay.json
PORT=3000

# Defaults to mongo when MONGODB_URI is set; use fixture to replay the synthetic demo.
# REPLAY_DATA_SOURCE=mongo
REPLAY_CORPUS_VERSION=cord19-2020-starter-v1

# Opt in to paid model reasoning for NEW runs. Existing readers are preserved.
REPLAY_AGENT_ENGINE=reader
OPENAI_API_KEY=
# Choose an API model supporting strict structured outputs; use a pinned ID for comparisons.
OPENAI_MODEL=gpt-5.6-luna

# Optional frozen pre-2020 knowledge for new runs
REPLAY_BASELINE_CORPUS_VERSION=

# Conservative corpus storage + index cap; 0 disables the local cap for explicitly approved Atlas autoscaling
CORPUS_STORAGE_LIMIT_BYTES=7000000000

# Agent memory, harnesses, events and checkpoints
REPLAY_STATE_STORAGE=file
MONGODB_STATE_DB=scientist_state
# Dedicated readWrite scientist_state user; temporary fallback is MONGODB_URI
MONGODB_STATE_URI=
